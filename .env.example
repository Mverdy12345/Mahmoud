# انسخ إلى .env.local محليًا — ونفس القيم في Vercel → Settings → Environment Variables
# لا تضع أي قيمة حقيقية في المستودع إطلاقًا

# Turso (إلزاميان) — إنشاء قاعدة مجانية: turso db create <name>
# الرابط: turso db show <name> --url — التوكن: turso db tokens create <name>
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# خدمة دمج الفيديو (نشر مجلد merger/ على Vercel ثم ضع رابطها هنا)
MERGER_API_BASE=https://<your-merger.vercel.app>

# اختياري
# MCP_ACCESS_TOKEN=            # إن ضُبط يُطلب Bearer token على /mcp
# KIE_IMAGE_MODEL=             # تجاوز أسماء الموديلات إن لزم
# KIE_VIDEO_MODEL=
# COMETAPI_IMAGE_MODEL=
# COMETAPI_VIDEO_MODEL=
